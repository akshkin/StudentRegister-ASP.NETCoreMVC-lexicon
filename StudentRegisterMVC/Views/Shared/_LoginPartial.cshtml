@using Microsoft.AspNetCore.Identity;
@inject SignInManager<ApplicationUser> signInManager;

<ul class="navbar-nav align-items-center ms-auto">
    @* @if (signInManager.IsSignedIn(User)) *@
    @if(Context.Session.GetString("jwt") != null)
    {
        <li class="nav-item">
            <form asp-controller="Account" asp-action="Logout">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-link nav-link text-dark">
                    Logout
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a asp-controller="Account" asp-action="Login" class="nav-link text-dark">
                Login
            </a>
        </li>
        <li class="nav-item">
            <a asp-controller="Account" asp-action="Register" class="nav-link text-dark">
                Register
            </a>
        </li>
    }
</ul>
